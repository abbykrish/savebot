{
  "manifest_version": 3,
  "name": "SaveBot",
  "version": "1.0.0",
  "description": "Save articles, highlights, and PDFs to SaveBot",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "https://savebot.app/*", "https://*.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-highlight": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save highlighted text"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
